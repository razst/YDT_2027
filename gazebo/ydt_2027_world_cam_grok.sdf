<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="grass_balls">

    <!-- Physics settings -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Core systems for Jetty -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Lighting -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <ambient>0.5 0.55 0.45 1</ambient>
    <background>0.6 0.75 0.95 1</background>

    <!-- ========== GRASS TERRAIN ========== -->
    <model name="grass_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <surface>
            <!-- Grass-like contact properties -->
            <friction>
              <ode>
                <mu>0.65</mu>      <!-- typical grass / rubber -->
                <mu2>0.65</mu2>
              </ode>
              <torsional>
                <coefficient>0.4</coefficient>
                <use_patch_radius>true</use_patch_radius>
                <patch_radius>0.05</patch_radius>
              </torsional>
            </friction>
            <bounce>
              <restitution_coefficient>0.25</restitution_coefficient>  <!-- soft grass bounce -->
              <threshold>0.01</threshold>
            </bounce>
            <contact>
              <ode>
                <kp>1e6</kp>
                <kd>100</kd>
                <max_vel>5.0</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <!-- Simple realistic grass green (no external texture required) -->
            <ambient>0.15 0.35 0.12 1</ambient>
            <diffuse>0.25 0.55 0.18 1</diffuse>
            <specular>0.05 0.08 0.04 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========== BALLS ========== -->
    <!-- Common ball properties:
         radius = 0.035 m (7 cm diameter)
         mass   = 0.15 kg
         I = 2/5 * m * r² ≈ 7.35e-5
    -->

    <!-- Red ball -->
    <model name="red_ball">
      <pose>0.0 0.0 1.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.15</mass>
          <inertia>
            <ixx>7.35e-5</ixx>
            <iyy>7.35e-5</iyy>
            <izz>7.35e-5</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <sphere><radius>0.035</radius></sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.7</mu>
                <mu2>0.7</mu2>
              </ode>
              <torsional>
                <coefficient>0.5</coefficient>
                <use_patch_radius>true</use_patch_radius>
                <patch_radius>0.035</patch_radius>
                <surface_radius>0.035</surface_radius>
              </torsional>
            </friction>
            <bounce>
              <restitution_coefficient>0.65</restitution_coefficient>
              <threshold>0.01</threshold>
            </bounce>
            <contact>
              <ode>
                <kp>1e7</kp>
                <kd>50</kd>
                <max_vel>10</max_vel>
                <min_depth>0.0005</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere><radius>0.035</radius></sphere>
          </geometry>
          <material>
            <ambient>0.7 0.1 0.1 1</ambient>
            <diffuse>0.95 0.15 0.15 1</diffuse>
            <specular>0.4 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Blue ball -->
    <model name="blue_ball">
      <pose>0.15 0.1 0.05 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.15</mass>
          <inertia>
            <ixx>7.35e-5</ixx>
            <iyy>7.35e-5</iyy>
            <izz>7.35e-5</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <sphere><radius>0.035</radius></sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.7</mu>
                <mu2>0.7</mu2>
              </ode>
              <torsional>
                <coefficient>0.5</coefficient>
                <use_patch_radius>true</use_patch_radius>
                <patch_radius>0.035</patch_radius>
                <surface_radius>0.035</surface_radius>
              </torsional>
            </friction>
            <bounce>
              <restitution_coefficient>0.65</restitution_coefficient>
              <threshold>0.01</threshold>
            </bounce>
            <contact>
              <ode>
                <kp>1e7</kp>
                <kd>50</kd>
                <max_vel>10</max_vel>
                <min_depth>0.0005</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere><radius>0.035</radius></sphere>
          </geometry>
          <material>
            <ambient>0.1 0.15 0.6 1</ambient>
            <diffuse>0.15 0.25 0.95 1</diffuse>
            <specular>0.2 0.25 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- White ball -->
    <model name="white_ball">
      <pose>-0.12 0.15 0.05 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.15</mass>
          <inertia>
            <ixx>7.35e-5</ixx>
            <iyy>7.35e-5</iyy>
            <izz>7.35e-5</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <sphere><radius>0.035</radius></sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.7</mu>
                <mu2>0.7</mu2>
              </ode>
              <torsional>
                <coefficient>0.5</coefficient>
                <use_patch_radius>true</use_patch_radius>
                <patch_radius>0.035</patch_radius>
                <surface_radius>0.035</surface_radius>
              </torsional>
            </friction>
            <bounce>
              <restitution_coefficient>0.65</restitution_coefficient>
              <threshold>0.01</threshold>
            </bounce>
            <contact>
              <ode>
                <kp>1e7</kp>
                <kd>50</kd>
                <max_vel>10</max_vel>
                <min_depth>0.0005</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere><radius>0.035</radius></sphere>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========== CAMERA ========== -->
    <model name="camera">
      <static>true</static>
      <pose>-0.8 0.0 0.45 0 0.35 0</pose>   <!-- looking toward origin / balls -->
      <link name="link">
        <!-- Tiny visual so you can see the camera position -->
        <visual name="visual">
          <geometry>
            <box><size>0.04 0.04 0.04</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>

        <sensor name="camera" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>camera</topic>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>  <!-- ~60° -->
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>20</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- Optional: GUI starting pose (good overview of the balls) -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-1.2 -0.8 0.9 0 0.5 0.6</pose>
      </camera>
    </gui>

  </world>
</sdf>
